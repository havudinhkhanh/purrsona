{
  "manifest_version": 3,
  "name": "Purrsona · Mèo đọc ké",
  "short_name": "Purrsona",
  "version": "1.1.0",
  "description": "Con mèo chì ngồi góc trang: gạch dưới chữ bạn đã học, rê vào ra nghĩa, bôi đen là lưu vô sổ, và kháy theo trang bạn đọc.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Purrsona"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.bank/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://accounts.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://*.paypal.com/*"
      ],
      "js": [
        "words.js",
        "scan.js",
        "poses.js",
        "lines.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}